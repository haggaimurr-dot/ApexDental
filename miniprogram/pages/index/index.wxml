        </block>
      </block>
    </block>
    <block wx:elif="{{page === 'worklist' && profile && profile.isStaff}}">
      <view class="back" bindtap="goHome">← 返回工作台</view><text class="eyebrow">CLINIC TO-DO</text><view class="title">诊所待办</view><view class="subtitle">{{profile.role === 'frontdesk' ? '预约确认、取消申请与到店安排' : '按需关注程度和日期排列，处理后自动更新'}}</view>
      <view class="work-toolbar"><text class="section-sub">{{workUpdatedAt ? '更新于 ' + workUpdatedAt : '尚未加载'}}</text><button class="mini-btn ghost-mini" disabled="{{workLoading}}" loading="{{workLoading}}" bindtap="loadWorklist">刷新</button></view>
