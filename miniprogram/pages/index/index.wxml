      <view wx:if="{{extSelected}}" class="card history-space"><view class="card-title">关注位置：{{extSelected.questionnaire.location}}</view><text class="care-instructions">持续时间：{{extSelected.questionnaire.duration}}
{{extSelected.questionnaire.symptoms}}
近期治疗：{{extSelected.questionnaire.recentTreatment}}</text><view class="field-label">拍摄指导</view><view class="hint">依次拍摄正面、上下牙列、左右侧。保持光线充足、镜头稳定、目标完整；拍摄不适时停止并联系诊所。格式检查不能判断口腔异常。</view><button wx:if="{{tab === 'patient' && extSelected.status === 'draft'}}" wx:for="{{extAngles}}" wx:key="id" class="mini-btn ghost-mini" disabled="{{extBusy}}" data-angle="{{item.id}}" bindtap="uploadScreeningAngle">拍摄/替换 {{item.name}}</button><button wx:for="{{extSelected.images}}" wx:key="id" class="mini-btn" data-id="{{item.id}}" bindtap="viewScreeningImage">查看 {{item.angle}}</button><view wx:for="{{extSelected.images}}" wx:key="id" class="slot-note">{{item.angle}} · {{item.quality.needsRetake ? '建议重拍：' : '通用质量检查通过'}}{{item.quality.issues}}</view><block wx:if="{{tab === 'patient' && extSelected.status === 'draft'}}"><checkbox-group bindchange="qualityOverride"><label class="consent"><checkbox value="accepted" checked="{{extQualityOverride}}" />如有质量警告，我已逐张人工核对并确认可供医生查看</label></checkbox-group><checkbox-group bindchange="privacyAccepted"><label class="consent"><checkbox value="accepted" />我已确认五张照片清晰、光线充足、目标完整</label></checkbox-group><checkbox-group wx:if="{{extResult.configured}}" bindchange="modelConsent"><label class="consent"><checkbox value="accepted" checked="{{extModelConsent}}" />同意将上述照片与问卷提交诊所已配置模型服务进行辅助分析</label></checkbox-group><button class="btn primary wide" disabled="{{extBusy}}" bindtap="submitScreening">提交医生复核</button></block><view wx:if="{{extSelected.review}}"><view class="field-label">医生复核意见</view><text class="article-body">{{extSelected.review.opinion}}</text><view class="slot-note">{{extSelected.review.reviewerName}} · {{extSelected.review.reviewedAt}}</view><button wx:if="{{tab === 'patient' && extSelected.review.service}}" class="btn primary wide" bindtap="bookScreeningService">预约推荐项目 · {{extSelected.review.service}}</button></view><block wx:if="{{tab === 'clinic' && extSelected.status === 'awaiting_doctor'}}"><view wx:if="{{extSelected.model.enabled}}" class="field-label">模型辅助提示（需人工核对）</view><text wx:for="{{extSelected.model.concerns}}" wx:key="*this" class="care-instructions">{{item}}</text><view class="slot-note">{{extSelected.model.note}}</view><view wx:if="{{extAnnotationImage}}" class="card history-space"><view class="field-label">{{extAnnotationImage.angle}} · 图片标注</view><view style="position:relative;width:100%;"><image src="{{extAnnotationImage.path}}" mode="widthFix" style="width:100%;display:block;" /><view wx:for="{{extAnnotations}}" wx:key="index" wx:if="{{item.angle === extAnnotationImage.angle}}" style="position:absolute;border:2px solid #28745c;left:{{item.x * 100}}%;top:{{item.y * 100}}%;width:{{item.width * 100}}%;height:{{item.height * 100}}%;"><text>{{item.label}}</text></view></view><input class="input" maxlength="200" data-field="label" value="{{extAnnotationEditor.label}}" bindinput="annotationInput" placeholder="标注说明" /><view class="field-label">框选位置与大小（百分比）</view><slider min="0" max="100" value="{{extAnnotationEditor.x}}" show-value data-field="x" bindchange="annotationInput" /><slider min="0" max="100" value="{{extAnnotationEditor.y}}" show-value data-field="y" bindchange="annotationInput" /><slider min="1" max="100" value="{{extAnnotationEditor.width}}" show-value data-field="width" bindchange="annotationInput" /><slider min="1" max="100" value="{{extAnnotationEditor.height}}" show-value data-field="height" bindchange="annotationInput" /><button class="mini-btn" bindtap="addScreeningAnnotation">保存此区域标注</button></view><textarea class="textarea" data-field="opinion" maxlength="3000" value="{{extEditor.opinion}}" bindinput="extensionInput" placeholder="复核意见（必填）" /><input class="input" data-field="service" value="{{extEditor.service}}" bindinput="extensionInput" placeholder="推荐项目名称（选填，须为启用项目）" /><view class="field-label">对模型辅助提示的人工评价（可不评价）</view><view class="choices"><button class="mini-btn ghost-mini" data-value="agree" bindtap="screeningAgreement">一致</button><button class="mini-btn ghost-mini" data-value="disagree" bindtap="screeningAgreement">不一致</button><button class="mini-btn ghost-mini" data-value="unknown" bindtap="screeningAgreement">不评价</button></view><button class="btn primary wide" disabled="{{extBusy}}" bindtap="reviewScreening">保存复核结果</button></block></view>
