<template name="recordAlbumPanel">
  <view class="section-title">照片归档</view><view wx:if="{{!patientRecordLoading && recordAlbum.length === 0}}" class="card empty">暂无归档照片</view>
  <view wx:for="{{recordAlbum}}" wx:key="id" class="card history-space"><view class="card-title">{{item.category}}</view><view class="appointment-meta">拍摄 {{item.capturedOn}} · {{item.angle}}{{item.tooth ? ' · 牙位 ' + item.tooth : ''}}</view><view class="appointment-meta">{{item.timeLabel}} · {{item.source === 'care' ? '患者恢复反馈' : '诊所归档'}}</view><text class="care-instructions">{{item.caption}}</text><button class="mini-btn" disabled="{{recordPhotoBusy}}" data-id="{{item.id}}" bindtap="previewRecordPhoto">查看照片</button><button wx:if="{{canCompare && item.source === 'record' && item.angle !== '未标注'}}" class="mini-btn ghost-mini" disabled="{{recordPhotoBusy}}" data-id="{{item.id}}" bindtap="toggleComparePhoto">{{item.compareChecked ? '取消对比选择' : '选入同角度对比'}}</button></view>
</template>
<template name="carePhotoPanel">
  <view class="card history-space"><view class="card-title">恢复照片{{editable ? '（选填）' : ''}}</view><view class="photo-grid"><view wx:for="{{carePhotos}}" wx:key="id" class="photo-cell"><image wx:if="{{item.url}}" class="recovery-photo" mode="aspectFill" src="{{item.url}}" data-id="{{item.id}}" bindtap="previewCarePhoto" /><view wx:else class="photo-placeholder">加载中</view><button wx:if="{{editable}}" class="mini-btn ghost-mini photo-remove" disabled="{{photoBusy || photosLoading || careBusy}}" data-id="{{item.id}}" bindtap="removeCarePhoto">移除</button></view></view><view wx:if="{{photosLoading}}" class="slot-note">正在加载照片…</view><view wx:if="{{photosError}}" class="slot-note">{{photosError}}<button class="mini-btn ghost-mini" disabled="{{photoBusy}}" bindtap="loadCarePhotos">重新加载照片</button></view><view wx:if="{{!editable && !photosLoading && !photosError && carePhotos.length === 0}}" class="slot-note">本次反馈未附照片</view><block wx:if="{{editable}}"><button class="btn ghost wide" disabled="{{photoBusy || photosLoading || careBusy || carePhotos.length >= 3}}" loading="{{photoBusy}}" bindtap="chooseCarePhotos">{{photoBusy ? '正在上传…' : '拍照或从相册选择'}}</button><view class="slot-note">最多 3 张，每张不超过 3 MB，支持 JPEG 和 PNG。照片会随本次反馈提交给接诊医生和诊所管理员查看。</view></block><view wx:else class="slot-note">点击照片可放大查看。</view></view>
</template>
<template name="memberFilterBar">
  <view class="member-filter"><view class="field-label">按就诊成员查看</view><scroll-view scroll-x class="member-scroll"><view class="member-chips"><view class="choice {{memberFilter === 'all' ? 'selected' : ''}}" data-id="all" bindtap="memberFilterChange">全部成员</view><view wx:for="{{members}}" wx:key="id" class="choice {{memberFilter === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="memberFilterChange">{{item.label}}</view><view class="choice {{memberFilter === 'unassigned' ? 'selected' : ''}}" data-id="unassigned" bindtap="memberFilterChange">未归属记录</view></view></scroll-view></view>
</template>
<template name="recallList">
  <view class="back" bindtap="goHome">← {{tab === 'patient' ? '返回首页' : '返回工作台'}}</view><text class="eyebrow">RECALL PLAN</text><view class="title">{{tab === 'patient' ? '我的复查安排' : '患者复查安排'}}</view><view class="subtitle">建议复查日期不占用号源，提交预约后由诊所确认。</view>
  <view wx:if="{{recalls.length === 0}}" class="card empty history-space">暂无复查安排</view>
  <view wx:for="{{recalls}}" wx:key="appointmentId" class="card history-space"><view class="appointment-top"><text class="patient-name">{{item.patient}} · {{item.doctor}}</text><text class="badge {{item.overdue ? 'care-attention' : ''}}">{{item.statusLabel}}</text></view><view class="appointment-meta">建议复查日期 {{item.dueDate}} · {{item.service}}</view><view wx:if="{{item.status !== 'completed'}}" class="slot-note">{{item.booking ? '已预约复诊' : '建议复查'}}：{{item.countdownDays > 0 ? '还有 ' + item.countdownDays + ' 天' : item.countdownDays === 0 ? '今天' : '已过 ' + (0 - item.countdownDays) + ' 天'}}</view><text class="care-instructions">{{item.instructions}}</text><view wx:if="{{item.booking}}" class="appointment-meta">已约 {{item.booking.date}} {{item.booking.slot}} · {{item.booking.status}}</view><button wx:if="{{tab === 'patient' && item.mayManage && item.status === 'pending'}}" class="mini-btn" data-id="{{item.nodeId || item.appointmentId}}" bindtap="startRecallBooking">选择时段预约复查</button><button wx:if="{{item.booking}}" class="mini-btn" data-id="{{item.booking.id}}" bindtap="openHistory">查看复查记录</button><button class="mini-btn ghost-mini" data-id="{{item.appointmentId}}" bindtap="openHistory">查看原就诊记录</button></view>
</template>
<template name="historyDetail">
  <view class="back" bindtap="returnFromHistory">← {{tab === 'patient' ? '返回健康档案' : historyFromSearch ? '返回检索结果' : '返回工作台'}}</view>
  <text class="eyebrow">HEALTH TIMELINE</text><view class="title">就诊时间轴</view>
  <view wx:if="{{historyLoading}}" class="card empty history-space">正在加载记录…</view>
  <view wx:elif="{{historyError}}" class="card empty history-space">{{historyError}}<button class="btn ghost wide" bindtap="retryHistory">重新加载</button></view>
  <block wx:elif="{{selectedHistory}}">
    <button class="btn ghost wide" bindtap="showTreatmentStages">治疗阶段、牙位与内容确认</button><button class="btn ghost wide" bindtap="showRecallSeries">多周期复查与长期续期</button>
    <button wx:if="{{tab === 'patient' && selectedHistory.appointment.mayManage}}" class="btn ghost wide summary-action" bindtap="startRecordRequest">申请更正或删除资料</button>
    <view class="card history-space"><view class="appointment-top"><text class="patient-name">{{selectedHistory.appointment.patient}}</text><text class="badge">{{selectedHistory.appointment.status}}</text></view><view class="appointment-meta">{{selectedHistory.appointment.service}} · {{selectedHistory.appointment.doctor}}</view><view class="appointment-meta">预约时间 {{selectedHistory.appointment.date}} {{selectedHistory.appointment.slot}}</view><view class="slot-note">以下按实际记录时间排列（北京时间）</view></view>
    <button wx:if="{{tab === 'patient' && !selectedHistory.appointment.memberId}}" class="btn ghost wide summary-action" bindtap="openMemberAssignment">将此记录归属到家庭成员</button>
    <button wx:if="{{selectedHistory.appointment.memberId}}" class="btn ghost wide summary-action" data-member="{{selectedHistory.appointment.memberId}}" bindtap="openPatientRecord">查看患者总览与跨就诊时间轴</button><button class="btn ghost wide summary-action" bindtap="openRecordAlbum">查看就诊与恢复照片</button><button class="btn ghost wide summary-action" bindtap="openAttachments">检查单 / 影像附件</button>
    <button wx:if="{{selectedHistory.appointment.canReschedule}}" class="btn ghost wide summary-action" data-id="{{selectedHistory.appointment.id}}" bindtap="openReschedule">调整预约时间</button><button wx:if="{{(tab === 'patient' && selectedHistory.appointment.mayManage) || (tab === 'clinic' && profile.role !== 'doctor')}}" class="mini-btn ghost-mini" data-id="{{selectedHistory.appointment.id}}" bindtap="showBilling">费用记录</button>
    <view wx:if="{{selectedHistory.summary}}" class="card"><view class="card-title">当前就诊小结</view><view class="appointment-meta">记录人：{{selectedHistory.summary.authorName}} · 第 {{selectedHistory.summary.version}} 版</view><view class="field-label">诊断 / 牙位</view><text class="care-instructions">{{selectedHistory.summary.structured.diagnosis || '未填写'}} · {{selectedHistory.summary.structured.teeth || '未填写'}}</text><view class="field-label">治疗项目 / 材料</view><text class="care-instructions">{{selectedHistory.summary.structured.procedure || '未填写'}} · {{selectedHistory.summary.structured.materials || '未填写'}}</text><view class="field-label">检查结果</view><text class="care-instructions">{{selectedHistory.summary.findings}}</text><view class="field-label">处置说明</view><text class="care-instructions">{{selectedHistory.summary.treatment}}</text><view class="field-label">后续安排</view><text class="care-instructions">{{selectedHistory.summary.nextSteps}}</text></view>
    <view wx:elif="{{selectedHistory.appointment.status === '已完成'}}" class="card empty">医生尚未填写就诊小结</view>
    <button wx:if="{{tab === 'clinic' && selectedHistory.appointment.status === '已完成'}}" class="btn primary wide summary-action" bindtap="editVisitSummary">{{selectedHistory.summary ? '修改就诊小结' : '填写就诊小结'}}</button>
    <view wx:if="{{selectedHistory.recall}}" class="card"><view class="appointment-top"><text class="card-title">复查安排</text><text class="badge">{{selectedHistory.recall.statusLabel}}</text></view><view class="appointment-meta">建议复查日期 {{selectedHistory.recall.dueDate}}</view><text class="care-instructions">{{selectedHistory.recall.instructions}}</text><button wx:if="{{tab === 'patient' && selectedHistory.recall.mayManage && selectedHistory.recall.status === 'pending'}}" class="mini-btn" data-id="{{selectedHistory.recall.appointmentId}}" bindtap="startRecallBooking">预约复查</button><view wx:if="{{selectedHistory.recall.booking}}" class="appointment-meta">复查预约 {{selectedHistory.recall.booking.date}} {{selectedHistory.recall.booking.slot}} · {{selectedHistory.recall.booking.status}}</view><button wx:if="{{selectedHistory.recall.booking}}" class="mini-btn" data-id="{{selectedHistory.recall.booking.id}}" bindtap="openHistory">查看复查记录</button></view>
    <button wx:if="{{tab === 'clinic' && selectedHistory.summary && (!selectedHistory.recall || selectedHistory.recall.status === 'pending')}}" class="btn ghost wide summary-action" bindtap="editRecall">{{selectedHistory.recall ? '调整复查安排' : '将后续安排设为复查'}}</button>
    <button wx:if="{{selectedHistory.previousAppointmentId}}" class="btn ghost wide summary-action" data-id="{{selectedHistory.previousAppointmentId}}" bindtap="openHistory">查看上次就诊记录</button>
    <view wx:if="{{selectedHistory.entries.length === 0}}" class="card empty">该旧记录暂无详细过程记录</view>
    <view class="history-timeline">
      <view wx:for="{{selectedHistory.entries}}" wx:key="id" class="history-item"><view class="history-dot {{item.type}}"></view><view class="history-time">{{item.timeLabel}}</view><view class="card history-card"><view class="card-title">{{item.title}}</view><text class="care-instructions">{{item.text}}</text><button wx:if="{{item.relatedAppointmentId}}" class="mini-btn" data-id="{{item.relatedAppointmentId}}" bindtap="openHistory">查看复查记录</button><button wx:if="{{item.taskId}}" class="mini-btn" data-taskid="{{item.taskId}}" bindtap="historyCareAction">{{item.taskStatus === 'draft' ? '编写护理任务' : (tab === 'patient' && selectedHistory.appointment.mayManage && item.taskStatus === 'published' ? '查看并反馈' : '查看护理详情')}}</button></view></view>
    </view>
  </block>
</template>
<template name="recordSearch">
  <view class="card history-space"><view class="field-label">就诊人姓名</view><input class="input" maxlength="60" value="{{recordName}}" data-field="recordName" bindinput="recordFilterChange" bindconfirm="searchRecords" confirm-type="search" placeholder="输入完整姓名或部分姓名" /><view class="field-label">预约日期范围（可不填）</view><view class="record-date-row"><picker mode="date" value="{{recordFrom}}" data-field="recordFrom" bindchange="recordFilterChange"><view class="input">{{recordFrom || '开始日期'}} ▾</view></picker><text>至</text><picker mode="date" value="{{recordTo}}" data-field="recordTo" bindchange="recordFilterChange"><view class="input">{{recordTo || '结束日期'}} ▾</view></picker></view><view class="field-label">医生</view><view wx:if="{{tab === 'clinic' && profile.role === 'doctor'}}" class="input">{{profile.doctorName}} · 仅本人</view><picker wx:else range="{{recordDoctors}}" value="{{recordDoctorIndex}}" data-field="recordDoctorIndex" bindchange="recordFilterChange"><view class="input">{{recordDoctors[recordDoctorIndex]}} ▾</view></picker><view class="button-row"><button class="btn ghost" bindtap="resetRecordFilters">重置条件</button><button class="btn primary" loading="{{recordLoading}}" disabled="{{recordLoading}}" bindtap="searchRecords">查找记录</button></view><view class="slot-note">日期含起止两天，按计划预约日期筛选。未填日期表示不限；同名就诊人分别保留，不会合并。</view></view>
  <view wx:if="{{recordDirty}}" class="card empty">条件已修改，点击“查找记录”查看结果。</view><view wx:elif="{{recordLoading && recordItems.length === 0}}" class="card empty">正在查找…</view><view wx:elif="{{!recordError && recordItems.length === 0}}" class="card empty">没有符合条件的记录<view class="slot-note">可缩小姓名关键词或重置筛选条件。</view></view>
  <view wx:if="{{recordError}}" class="card empty">{{recordError}}<button class="btn ghost wide" bindtap="{{recordItems.length ? 'moreRecords' : 'searchRecords'}}">重试</button></view>
  <view wx:if="{{!recordDirty && recordItems.length}}" class="section-sub record-result-count">共 {{recordTotal}} 条 · 已显示 {{recordItems.length}} 条 · 预约日期倒序</view>
  <view wx:for="{{recordItems}}" wx:key="id" class="card history-space"><view class="appointment-top"><text class="patient-name">{{item.patient}}</text><text class="badge">{{item.status}}</text></view><view class="appointment-meta">{{item.service}} · {{item.doctor}}</view><view class="appointment-meta">预约时间 {{item.date}} {{item.slot}}</view><view class="slot-note">{{item.hasSummary ? '已填写就诊小结' : item.status === '已完成' ? '尚未填写就诊小结' : '尚未完成接诊'}}</view><button class="mini-btn" data-id="{{item.id}}" bindtap="openHistory">查看就诊时间轴</button></view>
  <button wx:if="{{recordHasMore && !recordDirty}}" class="btn ghost wide" loading="{{recordLoading}}" disabled="{{recordLoading}}" bindtap="moreRecords">{{recordLoading ? '正在加载…' : '加载更多'}} </button>
</template>
<template name="rescheduleForm">
  <view class="back" bindtap="closeReschedule">← {{(rescheduleSaving || confirmationSaving) ? '正在保存…' : '返回原页面'}}</view><text class="eyebrow">RESCHEDULE</text><view class="title">{{tab === 'clinic' ? '预约详情与处理记录' : '预约改期与记录'}}</view><view class="subtitle">沿用原医生、服务和就诊成员，改期后由诊所重新确认。</view>
  <view wx:if="{{rescheduleLoading}}" class="card empty history-space">正在加载预约…</view>
  <view wx:if="{{rescheduleError}}" class="card empty history-space">{{rescheduleError}}<button class="btn ghost wide" disabled="{{rescheduleSaving || rescheduleLoading}}" bindtap="reloadReschedule">重新加载预约</button><view wx:if="{{rescheduleEditor}}" class="slot-note">提交结果不确定时可使用下方按钮重试；重新加载会清空未保存的选择和原因。</view></view>
  <block wx:if="{{rescheduleEditor && !rescheduleLoading}}">
    <view class="card history-space"><view class="appointment-top"><text class="patient-name">{{rescheduleEditor.patient}}</text><text class="badge">{{rescheduleEditor.status}}</text></view><view class="appointment-meta">{{rescheduleEditor.service}} · {{rescheduleEditor.doctor}}</view><view class="appointment-meta">当前预约 {{rescheduleEditor.date}} {{rescheduleEditor.slot}}</view></view>
    <block wx:if="{{tab === 'clinic'}}">
      <view class="card history-space"><view class="field-label">预约详情</view><view class="appointment-meta">联系电话：{{rescheduleEditor.phone}}</view><view class="appointment-meta">来源：{{rescheduleEditor.source}}</view><view class="care-instructions">患者备注：{{rescheduleEditor.note || '未填写'}}</view></view>
      <view wx:if="{{rescheduleEditor.status === '待确认'}}" class="card history-space"><view class="field-label">预约确认沟通说明（必填）</view><textarea class="input care-textarea" maxlength="500" disabled="{{confirmationSaving || rescheduleSaving}}" value="{{confirmationNote}}" bindinput="confirmationNoteInput" placeholder="记录沟通方式、患者确认情况及需要跟进的事项" /><view class="slot-note">{{confirmationNote.length}} / 500 字 · 保存后自动记录操作人及北京时间，沟通说明仅诊所内部可见。</view><view wx:if="{{confirmationError}}" class="slot-note">{{confirmationError}}</view><button class="btn primary wide" loading="{{confirmationSaving}}" disabled="{{confirmationSaving || rescheduleSaving}}" bindtap="submitConfirmation">保存说明并确认预约</button></view>
      <view class="section-title">确认沟通记录</view><view wx:if="{{rescheduleEditor.confirmations.length === 0}}" class="card empty">暂无沟通记录；历史确认不会补造说明。</view><view wx:for="{{rescheduleEditor.confirmations}}" wx:key="id" class="card history-space"><view class="field-label">{{item.actorName}} · {{item.actorRoleLabel}}</view><view class="appointment-meta">{{item.timeLabel}} · 北京时间</view><view class="appointment-meta">确认时段：{{item.date}} {{item.slot}}</view><view class="care-instructions">{{item.note}}</view></view>
    </block>
    <view wx:if="{{rescheduleEditor.canChange}}" class="card"><view class="field-label">新的预约日期</view><picker disabled="{{rescheduleSaving || confirmationSaving}}" range="{{rescheduleDates}}" range-key="label" value="{{rescheduleDateIndex}}" bindchange="rescheduleDateChange"><view class="input">{{rescheduleDates[rescheduleDateIndex].label}} ▾</view></picker><view class="field-label">新的时段</view><view wx:if="{{rescheduleAvailabilityLoading}}" class="slot-note">正在加载号源…</view><view wx:elif="{{rescheduleSlotError}}" class="slot-note">{{rescheduleSlotError}}<button class="mini-btn ghost-mini" disabled="{{rescheduleSaving || confirmationSaving}}" bindtap="loadRescheduleSlots">重新加载号源</button></view><view wx:elif="{{rescheduleSlots.length === 0}}" class="slot-note">该医生当天暂无开放时段，请选择其他日期。</view><view class="choices"><view wx:for="{{rescheduleSlots}}" wx:key="time" class="choice slot {{rescheduleSlot === item.time ? 'selected' : ''}} {{item.disabled ? 'disabled' : ''}}" data-slot="{{item.time}}" bindtap="rescheduleSelectSlot">{{item.time}}<text class="slot-note">{{item.disabled ? '不可选' : '余 ' + item.remaining}}</text></view></view><view class="field-label">改期原因</view><textarea class="input care-textarea" disabled="{{rescheduleSaving || confirmationSaving}}" maxlength="500" value="{{rescheduleReason}}" bindinput="rescheduleReasonInput" placeholder="填写 2–500 字的改期原因" /><view class="slot-note">请选择明天至未来 30 天内的开放时段。保存成功后原号源释放，新预约重新待确认；失败时保留原预约。改期原因会展示给预约管理人、已授权家人及有权查看记录的员工。</view><button class="btn primary wide" loading="{{rescheduleSaving}}" disabled="{{confirmationSaving || rescheduleSaving || rescheduleAvailabilityLoading || rescheduleSlotError || !rescheduleSlot}}" bindtap="submitReschedule">保存改期，重新待确认</button><button wx:if="{{tab === 'patient'}}" class="btn ghost wide" disabled="{{rescheduleSaving}}" data-request="true" bindtap="submitReschedule">提交改期申请，由诊所审批</button></view>
    <view wx:else class="card empty">当前状态不可改期，可查看下方历史记录。</view>
    <view class="section-title">变更记录</view><view wx:if="{{rescheduleEditor.changes.length === 0}}" class="card empty">暂无改期记录</view><view wx:for="{{rescheduleEditor.changes}}" wx:key="id" class="card"><view class="card-title">{{item.oldDate}} {{item.oldSlot}} → {{item.newDate}} {{item.newSlot}}</view><view class="appointment-meta">{{item.timeLabel}} · {{item.actorName}}</view><view class="appointment-meta">原状态 {{item.oldStatus}} · 改期后待确认</view><text class="care-instructions">{{item.reason}}</text></view>
  </block>
</template>
<view class="app">
  <view class="header">
    <view class="logo">A</view><view class="brand"><text>ApexDental</text><text class="brand-sub">口腔健康服务平台</text></view>
    <view class="demo" bindtap="checkConnection">{{storageMode}} · {{roleLabel}} ↻</view>
  </view>
  <view class="tabs"><view class="tab {{tab === 'patient' ? 'active' : ''}}" data-tab="patient" bindtap="setTab">患者端</view><view wx:if="{{profile && profile.isStaff}}" class="tab {{tab === 'clinic' ? 'active' : ''}}" data-tab="clinic" bindtap="setTab">诊所工作台</view></view>
  <view wx:if="{{tab === 'clinic' && page === 'home' && profile.role === 'admin'}}" class="work-actions"><button class="mini-btn" bindtap="showGuardianAdmin">监护人核验队列</button><button class="mini-btn" bindtap="showPrivacyRequests">访问 / 导出 / 注销申请</button><button class="mini-btn" bindtap="showRecordLogs">访问 / 下载日志</button></view>
  <template wx:if="{{tab === 'patient' && (page === 'home' || page === 'appointments' || page === 'history' || page === 'care' || page === 'recalls')}}" is="memberFilterBar" data="{{members,memberFilter}}" />

  <view wx:if="{{page === 'home' && tab === 'patient'}}" class="my-entry" bindtap="showNotifications"><view><text class="my-entry-title">消息与订阅提醒</text><text class="my-entry-sub">预约、护理反馈与复查提醒</text></view><text class="arrow">›</text></view>
  <view wx:if="{{page === 'home' && tab === 'clinic' && profile.role === 'admin'}}" class="my-entry" bindtap="showNotificationAdmin"><view><text class="my-entry-title">消息发送记录</text><text class="my-entry-sub">查看失败原因、发送历史并重试</text></view><text class="arrow">›</text></view>
  <view wx:if="{{page === 'home' && (tab === 'patient' || profile.role === 'admin')}}" class="my-entry" bindtap="showRecordRequests"><view><text class="my-entry-title">健康档案资料请求</text><text class="my-entry-sub">{{tab === 'patient' ? '查看更正、删除申请与诊所回复' : '受理申请、核实资料并反馈处理结果'}}</text></view><text class="arrow">›</text></view>
  <block wx:if="{{page === 'care-plans' && (tab === 'patient' || profile.role === 'admin' || profile.role === 'doctor')}}">
    <view class="back" bindtap="goHome">← 返回{{tab === 'clinic' ? '工作台' : '首页'}}</view>
    <text class="eyebrow">AFTERCARE PLAN</text><view class="title">诊后多节点计划</view>
    <view class="subtitle">按计划管理护理节点，逐项反馈与跟进。</view>
    <template wx:if="{{tab === 'patient'}}" is="memberFilterBar" data="{{members,memberFilter}}" />
    <view wx:if="{{planError}}" class="card empty">{{planError}}</view>
    <view wx:if="{{planLoading}}" class="card empty">正在加载…</view>
    <block wx:if="{{planEditor}}">
      <view class="card history-space"><view class="card-title">{{planEditor.patient}} · 计划草稿</view>
        <view class="field-label">计划名称</view><input class="input" disabled="{{planBusy}}" maxlength="80" value="{{planEditor.title}}" data-field="title" bindinput="carePlanInput" />
        <view class="field-label">流程起始日期（治疗日期）</view><picker mode="date" disabled="{{planBusy}}" value="{{planEditor.anchorDate}}" data-field="anchorDate" bindchange="carePlanInput"><view class="picker-value">{{planEditor.anchorDate}} ⌄</view></picker><view class="field-label">专属流程</view><view class="choices"><button wx:for="{{careWorkflows}}" wx:key="id" class="mini-btn ghost-mini" data-id="{{item.id}}" bindtap="applyCareWorkflow" disabled="{{planBusy}}">{{item.name}}</button></view><view class="slot-note">选用流程会替换当前草稿节点。日期以所选治疗日期为起点，已过期的节点调整到今天；请医生逐项核对日期和护理说明。</view>
        <view class="slot-note">最多 20 个节点。保存后可预览，统一发送后患者可查看全部节点；反馈日期用于到期提醒。</view>
      </view>
      <view wx:for="{{planEditor.nodes}}" wx:key="_key" class="card history-space">
        <view class="card-title">节点 {{index + 1}}{{item.taskId ? ' · 已有任务' : ''}}</view>
        <block wx:if="{{item.taskId}}"><view class="appointment-meta">{{item.title}} · {{item.dueDate}}</view><text class="care-instructions">{{item.instructions}}</text></block>
        <block wx:else>
          <view class="field-label">阶段名称</view><input class="input" maxlength="80" disabled="{{planBusy}}" value="{{item.phase}}" data-index="{{index}}" data-field="phase" bindinput="carePlanInput" /><view class="field-label">节点标题</view><input class="input" maxlength="80" disabled="{{planBusy}}" value="{{item.title}}" data-index="{{index}}" data-field="title" bindinput="carePlanInput" />
          <view class="field-label">护理说明</view><textarea class="input textarea care-textarea" maxlength="3000" disabled="{{planBusy}}" value="{{item.instructions}}" data-index="{{index}}" data-field="instructions" bindinput="carePlanInput" />
          <view class="field-label">反馈日期</view><picker mode="date" disabled="{{planBusy}}" value="{{item.dueDate}}" data-index="{{index}}" data-field="dueDate" bindchange="carePlanInput"><view class="picker-value">{{item.dueDate}} ⌄</view></picker>
          <view class="schedule-toggle"><text>无异常反馈自动随访</text><switch disabled="{{planBusy}}" checked="{{item.autoNormal}}" color="#28745c" data-index="{{index}}" data-field="autoNormal" bindchange="carePlanInput" /></view><view class="slot-note">仅无疼痛、无出血、无肿胀且没有补充文字或照片的反馈自动完成；其他反馈交诊所处理。后续节点继续按设定日期提醒。</view><view class="field-label">逾期多少天标记失访（1–30）</view><input class="input" type="number" disabled="{{planBusy}}" value="{{item.lossAfterDays || 7}}" data-index="{{index}}" data-field="lossAfterDays" bindinput="carePlanInput" /><view class="field-label">再次联系间隔（1–30 天）</view><input class="input" type="number" disabled="{{planBusy}}" value="{{item.followupIntervalDays || 3}}" data-index="{{index}}" data-field="followupIntervalDays" bindinput="carePlanInput" />
        </block>
        <view class="actions"><button class="mini-btn ghost-mini" disabled="{{planBusy || index === 0}}" data-index="{{index}}" data-direction="-1" bindtap="changeCarePlanNode">上移</button><button class="mini-btn ghost-mini" disabled="{{planBusy || index === planEditor.nodes.length - 1}}" data-index="{{index}}" data-direction="1" bindtap="changeCarePlanNode">下移</button><button class="mini-btn ghost-mini" disabled="{{planBusy}}" data-index="{{index}}" data-direction="remove" bindtap="changeCarePlanNode">移除</button></view>
      </view>
      <button class="btn ghost wide" disabled="{{planBusy || planEditor.nodes.length >= 20}}" bindtap="addCarePlanNode">添加护理节点</button>
      <view wx:if="{{planCandidates.length}}" class="card history-space"><view class="card-title">归入本次就诊已有任务</view><view class="slot-note">归入保留原反馈和处理记录，不会再次发送该任务。</view><button wx:for="{{planCandidates}}" wx:key="id" class="btn ghost wide" disabled="{{planBusy || planEditor.nodes.length >= 20}}" data-id="{{item.id}}" bindtap="addExistingCareNode">{{item.title}} · {{item.dueDate}}</button></view>
      <button class="btn primary wide" loading="{{planBusy}}" disabled="{{planBusy}}" bindtap="saveCarePlan">保存草稿并预览</button>
    </block>
    <block wx:elif="{{planSelected}}">
      <button class="mini-btn ghost-mini" disabled="{{planBusy}}" bindtap="showCarePlans">返回计划列表</button>
      <view class="card history-space"><view class="appointment-top"><text class="card-title">{{planSelected.title}}</text><text class="badge">{{planSelected.statusLabel}}</text></view><view class="appointment-meta">{{planSelected.patient}} · {{planSelected.doctor}}</view><view wx:if="{{tab === 'clinic' && (planSelected.status === 'active' || planSelected.status === 'paused')}}" class="button-row"><button class="mini-btn" disabled="{{planBusy || planSelected.nodes.length >= 20}}" bindtap="addFollowupNode">追加后续/长期维护节点</button><button class="mini-btn" disabled="{{planBusy}}" data-action="{{planSelected.status === 'paused' ? 'resume' : 'pause'}}" bindtap="maintainCarePlan">{{planSelected.status === 'paused' ? '恢复计划' : '暂停未反馈节点'}}</button><button class="mini-btn ghost-mini" disabled="{{planBusy}}" data-action="archive" bindtap="maintainCarePlan">终止未反馈节点</button></view><view wx:if="{{planNodeEditor}}" class="card history-space"><view class="field-label">{{planNodeTaskId ? '编辑未反馈节点' : '追加后续节点'}}</view><input class="input" maxlength="80" data-field="title" disabled="{{planBusy}}" value="{{planNodeEditor.title}}" bindinput="followupNodeInput" placeholder="标题" /><input class="input" maxlength="80" data-field="phase" disabled="{{planBusy}}" value="{{planNodeEditor.phase}}" bindinput="followupNodeInput" placeholder="阶段名称" /><textarea class="textarea" maxlength="3000" data-field="instructions" disabled="{{planBusy}}" value="{{planNodeEditor.instructions}}" bindinput="followupNodeInput" placeholder="医生护理说明" /><picker mode="date" data-field="dueDate" disabled="{{planBusy}}" value="{{planNodeEditor.dueDate}}" bindchange="followupNodeInput"><view class="input">{{planNodeEditor.dueDate}}</view></picker><button class="btn primary wide" disabled="{{planBusy}}" bindtap="saveFollowupNode">确认并保存节点</button></view><view class="appointment-meta">完成率 {{planSelected.completionRate}} · 已处理 {{planSelected.done}} / {{planSelected.total}} · 已反馈 {{planSelected.submitted}} · 失访 {{planSelected.lost}} · 逾期 {{planSelected.overdue}} · 需关注 {{planSelected.attention}}</view><button wx:if="{{tab === 'clinic' && planSelected.status === 'draft'}}" class="btn ghost wide" disabled="{{planBusy}}" bindtap="editCarePlan">编辑节点</button><view wx:if="{{planSelected.status === 'draft'}}" class="slot-note">请核对以下节点和日期；点击发送将一次性发送所有新增节点。</view><button wx:if="{{tab === 'clinic' && planSelected.status === 'draft'}}" class="btn primary wide" loading="{{planBusy}}" disabled="{{planBusy}}" bindtap="publishCarePlan">确认并发送整个计划</button></view>
      <view wx:for="{{planSelected.nodes}}" wx:key="_key" class="card history-space"><view class="appointment-top"><text class="card-title">{{index + 1}}. {{item.title}}</text><text class="badge">{{item.statusLabel}}</text></view><view class="appointment-meta">{{item.phase}} · 反馈日期 {{item.dueDate}}{{item.followupState === 'lost' ? ' · 失访待跟进' : ''}}</view><view wx:if="{{item.autoNormal}}" class="slot-note">本阶段已启用无异常反馈自动随访</view><text class="care-instructions">{{item.instructions}}</text><view wx:if="{{item.feedback && item.feedback.attention && item.status === 'waiting_review'}}" class="slot-note">该节点反馈需关注</view><text wx:if="{{item.resolution}}" class="care-instructions">处理意见：{{item.resolution.note}}</text><button wx:if="{{tab === 'clinic' && (item.status === 'published' || item.status === 'paused' || item.status === 'scheduled')}}" class="mini-btn ghost-mini" disabled="{{planBusy}}" data-id="{{item.id}}" bindtap="editFollowupNode">修改未反馈节点</button><button wx:if="{{planSelected.status !== 'draft' && item.status !== 'archived' && (tab === 'clinic' || item.status === 'published' || item.status === 'waiting_review' || item.status === 'resolved')}}" class="mini-btn" data-id="{{item.id}}" bindtap="openCarePlanTask">{{tab === 'patient' ? '查看护理与反馈' : '查看并处理节点'}}</button></view>
      <view wx:if="{{planSelected.status !== 'draft'}}" class="card history-space"><view class="card-title">阶段照片 · {{planSelected.stagePhotos.length || 0}} 张</view><view wx:if="{{!planSelected.stagePhotos.length}}" class="slot-note">暂无阶段照片，可在节点恢复反馈中上传。</view><view wx:for="{{planSelected.stagePhotos}}" wx:key="id" class="appointment-meta">{{item.phase}} · {{item.dueDate}}<button class="mini-btn ghost-mini" data-id="{{item.taskId}}" bindtap="openCarePlanTask">查看本阶段照片</button></view></view>
    </block>
    <block wx:else>
      <button class="mini-btn" disabled="{{planLoading}}" bindtap="loadCarePlans">刷新计划</button>
      <view class="choices"><view class="choice {{planFilter === 'all' ? 'selected' : ''}}" data-status="all" bindtap="filterCarePlans">全部</view><view wx:if="{{tab === 'clinic'}}" class="choice {{planFilter === 'draft' ? 'selected' : ''}}" data-status="draft" bindtap="filterCarePlans">草稿</view><view class="choice {{planFilter === 'active' ? 'selected' : ''}}" data-status="active" bindtap="filterCarePlans">进行中</view><view class="choice {{planFilter === 'completed' ? 'selected' : ''}}" data-status="completed" bindtap="filterCarePlans">已完成</view></view>
      <view wx:if="{{!planLoading && !planError && planVisible.length === 0}}" class="card empty">暂无符合条件的护理计划{{tab === 'clinic' ? '，可从已完成的预约安排多节点计划。' : '。'}}</view>
      <view wx:for="{{planVisible}}" wx:key="id" class="card history-space"><view class="appointment-top"><text class="card-title">{{item.title}}</text><text class="badge">{{item.statusLabel}}</text></view><view class="appointment-meta">{{item.patient}} · {{item.doctor}}</view><view class="appointment-meta">完成率 {{item.completionRate}} · 已处理 {{item.done}} / {{item.total}} · 失访 {{item.lost}} · 逾期 {{item.overdue}} · 需关注 {{item.attention}}</view><button class="mini-btn" data-id="{{item.id}}" bindtap="openCarePlan">查看计划</button></view>
    </block>
  </block>
  <block wx:elif="{{page === 'record-attachments'}}">
    <view class="back" bindtap="returnRecordFeature">← 返回就诊记录</view><view class="title">检查单 / 影像附件</view><view class="subtitle">{{featureVisit.patient}} · {{featureVisit.date}}</view><button class="mini-btn" disabled="{{featureBusy || featureLoading}}" bindtap="loadAttachments">刷新附件</button><view wx:if="{{featureLoading}}" class="card empty">正在加载…</view><view wx:if="{{featureError}}" class="card empty">{{featureError}}</view>
    <view wx:if="{{tab === 'clinic' && featureVisit.status === '已完成'}}" class="card history-space"><view class="field-label">附件分类</view><picker disabled="{{featureBusy}}" range="{{attachmentKinds}}" value="{{attachmentKindIndex}}" data-field="attachmentKindIndex" bindchange="attachmentInput"><view class="input">{{attachmentKinds[attachmentKindIndex]}} ▾</view></picker><view class="field-label">关联牙位（选填）</view><input class="input" type="number" maxlength="2" disabled="{{featureBusy}}" value="{{attachmentTooth}}" data-field="attachmentTooth" bindinput="attachmentInput" /><button class="btn primary wide" disabled="{{featureBusy || featureLoading}}" loading="{{featureBusy}}" bindtap="uploadAttachment">选择文件并归档</button><view class="slot-note">支持 PDF、JPEG、PNG、GIF、TIFF、DOCX、XLSX 和带 DICM 标识的 DICOM 文件，每份不超过 10 MB，每次就诊最多 30 份。患者及已授权家人可查看；DICOM 可下载，并支持未压缩灰度资料预览。</view></view>
    <view wx:if="{{!featureLoading && !attachments.length}}" class="card empty">暂无附件</view><view wx:for="{{attachments}}" wx:key="id" class="card history-space"><view class="card-title">{{item.kind}} · {{item.name}}</view><view class="appointment-meta">{{item.timeLabel}} · {{item.size}} 字节 {{item.tooth ? ' · 牙位 ' + item.tooth : ''}}</view><button class="mini-btn" disabled="{{featureBusy}}" data-id="{{item.id}}" bindtap="downloadAttachment">{{item.mime === 'application/dicom' ? '下载 / 转存影像文件' : '查看附件'}}</button><button wx:if="{{item.mime === 'application/dicom'}}" class="mini-btn ghost-mini" disabled="{{featureBusy}}" data-id="{{item.id}}" bindtap="previewDicom">灰度影像预览</button></view>
    <view wx:if="{{dicomFile}}" class="card history-space"><view class="card-title">{{dicomFile.name}} · 资料预览</view><image wx:if="{{dicomPreview}}" src="{{dicomPreview}}" mode="widthFix" style="width:100%" /><view class="slot-note">未压缩小端灰度影像；保留原文件。此预览不替代专业诊断工作站。</view><input class="input" data-field="dicomCenter" type="digit" value="{{dicomCenter}}" bindinput="dicomInput" placeholder="窗位（留空使用影像默认值）" /><input class="input" data-field="dicomWidth" type="digit" value="{{dicomWidth}}" bindinput="dicomInput" placeholder="窗宽（留空使用影像默认值）" /><input class="input" data-field="dicomFrame" type="number" value="{{dicomFrame}}" bindinput="dicomInput" placeholder="帧编号，从0开始" /><button class="mini-btn" disabled="{{featureBusy}}" bindtap="renderDicomPreview">更新显示</button></view>
  </block>
  <block wx:elif="{{page === 'health-questionnaire'}}">
    <view class="back" bindtap="returnRecordFeature">← 返回患者档案</view><view class="title">口腔健康问卷</view><view class="subtitle">供接诊人员了解既往健康情况；填写内容不会自动生成诊断。</view><button class="mini-btn" disabled="{{featureBusy || featureLoading}}" bindtap="loadQuestionnaire">重新加载</button><view wx:if="{{featureLoading}}" class="card empty">正在加载…</view><view wx:if="{{featureError}}" class="card empty">{{featureError}}</view>
    <view wx:if="{{healthEditor}}" class="card history-space"><view class="card-title">{{healthEditor.version ? '当前第 ' + healthEditor.version + ' 版' : '首次填写'}}</view><view wx:for="{{healthQuestionFields}}" wx:key="key"><view class="field-label">{{item.label}}（最多 1000 字）</view><textarea class="input care-textarea" disabled="{{featureBusy || !healthMayEdit}}" maxlength="1000" value="{{healthEditor.answers[item.key]}}" data-field="{{item.key}}" bindinput="questionnaireInput" placeholder="可填写无、不清楚或相关情况" /></view>
    <view class="field-label">是否有异常出血史</view><radio-group data-field="bleedingHistory" bindchange="questionnaireInput"><label class="consent"><radio disabled="{{featureBusy || !healthMayEdit}}" value="true" checked="{{healthEditor.answers.bleedingHistory === true}}" />有</label><label class="consent"><radio disabled="{{featureBusy || !healthMayEdit}}" value="false" checked="{{healthEditor.answers.bleedingHistory === false}}" />无</label><label class="consent"><radio disabled="{{featureBusy || !healthMayEdit}}" value="unknown" checked="{{healthEditor.answers.bleedingHistory === null}}" />不清楚 / 不便回答</label></radio-group>
    <view class="field-label">是否怀孕</view><radio-group data-field="pregnant" bindchange="questionnaireInput"><label class="consent"><radio disabled="{{featureBusy || !healthMayEdit}}" value="true" checked="{{healthEditor.answers.pregnant === true}}" />是</label><label class="consent"><radio disabled="{{featureBusy || !healthMayEdit}}" value="false" checked="{{healthEditor.answers.pregnant === false}}" />否</label><label class="consent"><radio disabled="{{featureBusy || !healthMayEdit}}" value="unknown" checked="{{healthEditor.answers.pregnant === null}}" />不适用 / 不清楚 / 不便回答</label></radio-group>
    <view class="field-label">吸烟情况</view><radio-group data-field="tobacco" bindchange="questionnaireInput"><label wx:for="{{tobaccoOptions}}" wx:key="value" class="consent"><radio disabled="{{featureBusy || !healthMayEdit}}" value="{{item.value}}" checked="{{healthEditor.answers.tobacco === item.value}}" />{{item.label}}</label></radio-group>
    <block wx:if="{{healthMayEdit}}"><view class="schedule-toggle"><text>确认内容并提交给诊所查看</text><switch disabled="{{featureBusy}}" checked="{{healthConsent}}" data-field="consent" bindchange="questionnaireInput" color="#28745c" /></view><button class="btn primary wide" disabled="{{featureBusy || !healthConsent}}" loading="{{featureBusy}}" bindtap="saveHealthQuestionnaire">保存问卷版本</button><view class="slot-note">问卷修改保留旧版；未成年人问卷须先通过监护核验。共享家人和医生仅可查看。</view></block></view>
    <view class="section-title">问卷历史</view><view wx:for="{{healthVersions}}" wx:key="version" class="card"><view class="card-title">第 {{item.version}} 版 · {{item.timeLabel}}</view><text class="care-instructions">{{item.preview}}</text></view>
  </block>
  <block wx:elif="{{page === 'guardian-check'}}">
    <view class="back" bindtap="returnRecordFeature">← 返回患者档案</view><view class="title">身份 / 监护人核验</view><view class="subtitle">诊所管理员核对申请人身份及监护关系材料。家庭成员关系和只读授权不会自动成为监护证明。</view><button class="mini-btn" disabled="{{featureBusy || featureLoading}}" bindtap="loadGuardianCheck">刷新核验状态</button><view wx:if="{{featureLoading}}" class="card empty">正在加载…</view><view wx:if="{{featureError}}" class="card empty">{{featureError}}</view>
    <view wx:if="{{guardianState}}" class="card history-space"><view class="card-title">{{guardianState.verified ? '监护核验已通过' : guardianState.required ? '需完成监护或成年身份核验' : '当前无需监护核验'}}</view><view class="slot-note">子女档案默认需要核验；成年子女可提交身份材料由管理员确认成年。核验通过前不能为受保护成员新增共享、填写问卷或办理资料权利请求。撤销核验会同步撤销现有共享。</view></view>
    <view class="card"><view class="field-label">申请人姓名</view><input class="input" disabled="{{featureBusy}}" maxlength="60" value="{{guardianEditor.name}}" data-field="name" bindinput="guardianInput" /><view class="field-label">与成员的关系</view><view class="choices"><view wx:for="{{guardianRelationships}}" wx:key="*this" class="choice {{guardianEditor.relationship === item ? 'selected' : ''}}" data-field="relationship" data-value="{{item}}" bindtap="guardianInput">{{item}}</view></view><view class="field-label">联系电话</view><input class="input" disabled="{{featureBusy}}" type="number" maxlength="11" value="{{guardianEditor.phone}}" data-field="phone" bindinput="guardianInput" /><view class="field-label">成员出生日期</view><picker mode="date" disabled="{{featureBusy}}" value="{{guardianEditor.birthDate}}" data-field="birthDate" bindchange="guardianInput"><view class="input">{{guardianEditor.birthDate || '选择出生日期'}} ▾</view></picker><checkbox-group bindchange="guardianExternalConsent"><label class="consent"><checkbox value="accepted" checked="{{guardianExternalConsent}}" />同意诊所将本次姓名、关系、出生日期及材料提交已配置的外部身份服务辅助核对（可不选，诊所仍可人工核验）</label></checkbox-group><button class="btn primary wide" disabled="{{featureBusy || featureLoading}}" loading="{{featureBusy}}" bindtap="submitGuardianCheck">选择身份 / 监护材料并提交核验</button><view class="slot-note">材料采用私有 PDF 或 JPEG/PNG 文件，不超过 10 MB，仅本人和负责核验的管理员可下载。请按诊所要求准备材料；请勿上传无关证件。</view></view>
    <view wx:for="{{guardianState.checks}}" wx:key="id" class="card"><view class="card-title">{{item.guardianName}} · {{item.statusLabel}}</view><view class="appointment-meta">{{item.relationship}} · 成员出生日期 {{item.birthDate}}</view><text class="care-instructions">{{item.note}}</text><button class="mini-btn ghost-mini" disabled="{{featureBusy}}" data-id="{{item.id}}" bindtap="toggleGuardianExternalConsent">{{item.externalConsent ? '撤回外部辅助核对授权' : '同意外部辅助核对'}}</button><button wx:if="{{item.hasEvidence}}" class="mini-btn" disabled="{{featureBusy}}" data-id="{{item.id}}" bindtap="viewGuardianEvidence">查看所提交材料</button></view>
  </block>
  <block wx:elif="{{page === 'guardian-admin' && tab === 'clinic' && profile.role === 'admin'}}">
    <view class="back" bindtap="returnRecordFeature">← 返回工作台</view><view class="title">监护人核验队列</view><button class="mini-btn" disabled="{{featureBusy || featureLoading}}" bindtap="loadGuardianAdmin">刷新队列</button><view wx:if="{{featureLoading}}" class="card empty">正在加载…</view><view wx:if="{{featureError}}" class="card empty">{{featureError}}</view><view wx:if="{{!featureLoading && !guardianItems.length}}" class="card empty">暂无核验材料</view>
    <view wx:for="{{guardianItems}}" wx:key="id" class="card history-space"><view class="card-title">{{item.memberName}} · {{item.statusLabel}}</view><view class="appointment-meta">申请人 {{item.guardianName}} · {{item.relationship}}</view><button class="mini-btn" disabled="{{featureBusy}}" data-id="{{item.id}}" bindtap="selectGuardianReview">查看与处理</button></view>
    <button wx:if="{{guardianHasMore}}" class="btn ghost wide" disabled="{{featureLoading || featureBusy}}" bindtap="moreGuardianChecks">加载更多核验记录</button><view wx:if="{{guardianReview}}" class="card"><view class="card-title">{{guardianReview.memberName}} · {{guardianReview.guardianName}}</view><view class="appointment-meta">成员出生日期 {{guardianReview.birthDate}} · 联系电话 {{guardianReview.phone}}</view><view wx:if="{{guardianReview.externalResult.result}}" class="slot-note">外部辅助结果：{{guardianReview.externalResult.result === 'match' ? '资料匹配' : guardianReview.externalResult.result === 'mismatch' ? '存在不一致' : '未完成核对'}} · {{guardianReview.externalResult.reference}}</view><button wx:if="{{guardianReview.status === 'submitted'}}" class="mini-btn" disabled="{{featureBusy || !guardianReview.externalConsent || guardianReview.externalPending}}" bindtap="queryExternalIdentity">调用已授权外部身份服务</button><button wx:if="{{guardianReview.hasEvidence}}" class="mini-btn" disabled="{{featureBusy}}" data-id="{{guardianReview.id}}" bindtap="viewGuardianEvidence">核对身份 / 监护关系材料</button><view class="field-label">核验结论及依据（最多 1000 字）</view><textarea class="input care-textarea" disabled="{{featureBusy}}" maxlength="1000" value="{{guardianNote}}" data-field="guardianNote" bindinput="guardianInput" />
