      <view class="section-title">患者级档案总览</view><view wx:if="{{!members.length}}" class="card empty">请先添加成员并将历史记录归属到成员</view><button wx:for="{{members}}" wx:key="id" wx:if="{{memberFilter === 'all' || memberFilter === item.id}}" class="btn ghost wide" data-id="{{item.id}}" bindtap="openPatientRecord">{{item.name}} · {{item.relationship}} · 总览与统一时间轴</button><template is="recordSearch" data="{{tab,profile,recordName,recordFrom,recordTo,recordDoctorIndex,recordDoctors,recordItems,recordTotal,recordHasMore,recordLoading,recordError,recordDirty}}" />
    </block>
    <block wx:elif="{{page === 'history-detail'}}"><template is="historyDetail" data="{{tab, selectedHistory, historyLoading, historyError, historyFromSearch}}" /></block>
