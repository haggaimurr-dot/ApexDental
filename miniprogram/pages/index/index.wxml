      <view class="back" bindtap="showMembers">← 返回家庭成员</view><text class="eyebrow">MEMBER SHARING</text><view class="title">家庭成员授权</view><view class="subtitle">{{shareMember.name}} · 分享该成员已有及后续的就诊、护理和复查记录，包含已提交的恢复照片。家人获得只读权限。</view><button class="btn primary wide" disabled="{{shareBusy || !shareMember.enabled}}" loading="{{shareBusy}}" bindtap="issueMemberShare">生成一次性授权码</button><view wx:if="{{shareIssued}}" class="card history-space"><view class="card-title">{{shareIssued.code}}</view><view class="slot-note">有效至 {{shareIssued.expiresLabel}}。交给指定家人，由对方使用自己的微信账号在“家庭成员档案 → 接受家人授权”输入。</view><button class="btn ghost wide" bindtap="copyMemberShareCode">复制授权码</button></view>
      <view class="work-toolbar"><text class="card-title">授权名单</text><button class="mini-btn ghost-mini" disabled="{{shareLoading}}" bindtap="loadMemberShares">刷新</button></view><view wx:if="{{shareError}}" class="card empty">{{shareError}}</view><view wx:elif="{{shareLoading}}" class="card empty">正在加载授权…</view><block wx:else><view wx:if="{{shareList.length === 0}}" class="card empty">暂无已接受授权的家人</view><view wx:for="{{shareList}}" wx:key="id" class="card"><view class="appointment-top"><text class="patient-name">{{item.recipientName}}</text><text class="badge">{{item.enabled ? '只读授权' : '已撤销'}}</text></view><button wx:if="{{item.enabled}}" class="mini-btn ghost-mini" disabled="{{shareBusy}}" data-id="{{item.id}}" data-invite="{{false}}" bindtap="revokeMemberShare">撤销访问</button></view><view wx:for="{{shareInvites}}" wx:key="id" class="card"><view class="card-title">尚未接受的邀请</view><view class="slot-note">有效至 {{item.expiresLabel}}</view><button class="mini-btn ghost-mini" disabled="{{shareBusy}}" data-id="{{item.id}}" data-invite="{{true}}" bindtap="revokeMemberShare">撤销邀请</button></view></block>
    </block>
    <block wx:elif="{{page === 'share-accept'}}">
      <view class="back" bindtap="showMembers">← 返回家庭成员</view><text class="eyebrow">ACCEPT INVITATION</text><view class="title">接受家人授权</view><view class="subtitle">授权会绑定当前微信账号，请确认使用的是您自己的账号。</view><view class="card history-space"><view class="field-label">家庭授权码</view><input disabled="{{shareBusy}}" class="input" maxlength="18" value="{{shareCode}}" bindinput="shareCodeInput" placeholder="输入管理人提供的 18 位授权码" /><button class="btn ghost wide" disabled="{{shareBusy}}" bindtap="previewMemberShare">查看授权范围</button><block wx:if="{{sharePreview}}"><view class="field-label">授权成员：{{sharePreview.memberName}}</view><view class="slot-note">您将能查看该成员已有及后续的预约、结构化治疗记录、统一时间轴、护理反馈、复查记录、就诊归档及已提交恢复照片。此授权不能修改资料、预约或提交反馈。</view><view class="field-label">您的姓名或称呼</view><input disabled="{{shareBusy}}" class="input" maxlength="40" value="{{shareName}}" bindinput="shareNameInput" placeholder="用于管理人识别授权名单" /><button class="btn primary wide" disabled="{{shareBusy}}" loading="{{shareBusy}}" bindtap="acceptMemberShare">确认接受只读授权</button></block></view>
    </block>
