        <view class="card"><view class="card-title">服务项目 · 计划预约数</view><view wx:if="{{statistics.services.length === 0}}" class="slot-note">暂无数据</view><view wx:for="{{statistics.services}}" wx:key="label" class="statistics-distribution"><view class="statistics-row"><text>{{item.label}}</text><text>{{item.count}}</text></view><view class="statistics-track"><view class="statistics-fill planned" style="width: {{item.width}}%;"></view></view></view></view>
