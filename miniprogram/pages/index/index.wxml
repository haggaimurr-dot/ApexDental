      <view class="back" bindtap="returnToVisit">← 返回就诊时间轴</view><text class="eyebrow">PLAN NEXT VISIT</text><view class="title">安排复查</view><view class="subtitle">{{recallEditor.patient}} · {{recallEditor.doctor}}</view><view class="card history-space"><view class="field-label">建议复查日期</view><picker disabled="{{recallSaving}}" mode="date" start="{{careToday}}" value="{{recallEditor.dueDate}}" data-field="dueDate" bindchange="recallInput"><view class="picker-value">{{recallEditor.dueDate}} ⌄</view></picker><view class="field-label">复查说明（最多 1500 字）</view><textarea disabled="{{recallSaving}}" class="input textarea care-textarea" maxlength="1500" value="{{recallEditor.instructions}}" data-field="instructions" bindinput="recallInput" placeholder="说明复查目的及准备事项" /><view class="slot-note">默认带入就诊小结的后续安排，可按本次复查需要调整。发送后患者可见；患者还需选择开放时段提交预约。</view><button class="btn primary wide" disabled="{{recallSaving}}" loading="{{recallSaving}}" bindtap="saveRecall">发送复查安排</button></view>
    </block>
    <block wx:elif="{{page === 'summary-edit' && summaryEditor && profile && (profile.role === 'doctor' || profile.role === 'admin')}}">
      <view class="back" bindtap="returnToVisit">← 返回就诊时间轴</view><text class="eyebrow">VISIT SUMMARY</text><view class="title">医生就诊小结</view><view class="subtitle">{{summaryEditor.patient}} · {{summaryEditor.doctor}}</view>
      <view class="card history-space"><view class="field-label">诊断（最多 1000 字，选填）</view><textarea class="input care-textarea" disabled="{{summarySaving}}" maxlength="1000" value="{{summaryEditor.diagnosis}}" data-field="diagnosis" bindinput="summaryInput" /><view class="field-label">牙位（FDI 编号，空格分隔，如 11 36 55）</view><input class="input" disabled="{{summarySaving}}" maxlength="160" value="{{summaryEditor.teeth}}" data-field="teeth" bindinput="summaryInput" /><view class="field-label">治疗项目（最多 1000 字，选填）</view><textarea class="input care-textarea" disabled="{{summarySaving}}" maxlength="1000" value="{{summaryEditor.procedure}}" data-field="procedure" bindinput="summaryInput" /><view class="field-label">材料（最多 500 字，选填）</view><input class="input" disabled="{{summarySaving}}" maxlength="500" value="{{summaryEditor.materials}}" data-field="materials" bindinput="summaryInput" /><view class="field-label">检查结果（最多 2000 字）</view><textarea disabled="{{summarySaving}}" class="input textarea care-textarea" maxlength="2000" value="{{summaryEditor.findings}}" data-field="findings" bindinput="summaryInput" placeholder="记录本次检查发现及结果" /><view class="field-label">处置说明（最多 2000 字）</view><textarea disabled="{{summarySaving}}" class="input textarea care-textarea" maxlength="2000" value="{{summaryEditor.treatment}}" data-field="treatment" bindinput="summaryInput" placeholder="记录本次已进行的处置或服务；未进行处置请如实说明" /><view class="field-label">后续安排（最多 1500 字）</view><textarea disabled="{{summarySaving}}" class="input textarea care-textarea" maxlength="1500" value="{{summaryEditor.nextSteps}}" data-field="nextSteps" bindinput="summaryInput" placeholder="记录护理、复查或其他后续安排；暂无安排请如实说明" /><view class="slot-note">保存后患者可在健康档案中查看。修改将新增版本并保留原记录，请核对就诊人和内容。</view><button class="btn primary wide" disabled="{{summarySaving}}" loading="{{summarySaving}}" bindtap="saveVisitSummary">保存并展示给患者</button></view>
    </block>
    <block wx:elif="{{page === 'care-templates' && profile && (profile.role === 'doctor' || profile.role === 'admin')}}">
      <view class="back" bindtap="goHome">← 返回工作台</view><text class="eyebrow">CARE TEMPLATES</text><view class="title">护理模板</view><view class="subtitle">诊所共享常用护理说明；医生可维护自己创建的模板，管理员可维护全部。</view><view class="button-row"><button class="btn ghost" disabled="{{templateLoading}}" bindtap="reloadCareTemplates">刷新模板</button><button class="btn primary" bindtap="editCareTemplate">新建模板</button></view>
      <view wx:if="{{templateLoading}}" class="card empty history-space">正在加载模板…</view><view wx:elif="{{templateError}}" class="card empty history-space">{{templateError}}</view><view wx:elif="{{templates.length === 0}}" class="card empty history-space">暂无模板，可新建或从护理任务保存。</view>
      <block wx:else><textarea class="textarea" maxlength="1000" value="{{templateReviewNote}}" bindinput="templateReviewInput" placeholder="模板审核意见（通过或退回时必填）" /><view wx:for="{{templates}}" wx:key="id" class="card history-space"><view class="appointment-top"><text class="card-title">{{item.name}}</text><text class="badge">{{item.enabled ? '启用' : '已停用'}}</text></view><view class="appointment-meta">{{item.service}} · 使用后 {{item.feedbackDays}} 天反馈 · {{item.authorName}}</view><view class="appointment-meta">任务标题：{{item.title}}</view><text class="care-preview">{{item.instructions}}</text><view class="slot-note">{{item.reviewStatus === 'approved' || item.reviewStatus === 'legacy' ? '可使用' : item.reviewStatus === 'pending' ? '待独立审核' : item.reviewStatus === 'rejected' ? '已退回' : '草稿待提交'}} · {{item.reviewNote}}</view><button wx:if="{{item.reviewStatus === 'draft' || item.reviewStatus === 'rejected'}}" class="mini-btn" disabled="{{templateSaving}}" data-id="{{item.id}}" data-decision="submit" bindtap="reviewSingleTemplate">提交审核</button><block wx:if="{{item.reviewStatus === 'pending'}}"><button class="mini-btn" data-id="{{item.id}}" data-decision="withdraw" bindtap="reviewSingleTemplate">撤回</button><button class="mini-btn" disabled="{{templateSaving || item.editorId === profile.id}}" data-id="{{item.id}}" data-decision="approve" bindtap="reviewSingleTemplate">通过</button><button class="mini-btn ghost-mini" disabled="{{templateSaving || item.editorId === profile.id}}" data-id="{{item.id}}" data-decision="reject" bindtap="reviewSingleTemplate">退回</button></block><button wx:if="{{item.mayEdit}}" class="mini-btn" data-id="{{item.id}}" bindtap="editCareTemplate">编辑与启停</button></view></block>
    </block>
    <block wx:elif="{{page === 'template-edit' && templateEditor && profile && (profile.role === 'doctor' || profile.role === 'admin')}}">
      <view class="back" bindtap="returnFromTemplate">← 返回</view><text class="eyebrow">EDIT TEMPLATE</text><view class="title">{{templateEditor.id ? '编辑护理模板' : '新建护理模板'}}</view><view class="card history-space"><view class="field-label">模板名称（最多 60 字）</view><input disabled="{{templateSaving}}" class="input" maxlength="60" value="{{templateEditor.name}}" data-field="name" bindinput="templateInput" placeholder="便于诊所人员查找的名称" /><view class="field-label">适用服务项目</view><picker disabled="{{templateSaving}}" range="{{templateServices}}" value="{{templateServiceIndex}}" bindchange="templateServiceChange"><view class="picker-value">{{templateEditor.service}} ⌄</view></picker><view class="field-label">患者看到的任务标题</view><input disabled="{{templateSaving}}" class="input" maxlength="80" value="{{templateEditor.title}}" data-field="title" bindinput="templateInput" /><view class="field-label">护理说明（最多 3000 字）</view><textarea disabled="{{templateSaving}}" class="input textarea care-textarea" maxlength="3000" value="{{templateEditor.instructions}}" data-field="instructions" bindinput="templateInput" placeholder="填写可供重复使用的护理说明" /><view class="field-label">使用后多少天反馈（0–365 天，0 表示当天）</view><input disabled="{{templateSaving}}" class="input" type="number" maxlength="3" value="{{templateEditor.feedbackDays}}" data-field="feedbackDays" bindinput="templateInput" /><view class="schedule-toggle"><text>启用模板</text><switch disabled="{{templateSaving}}" checked="{{templateEditor.enabled}}" color="#28745c" data-field="enabled" bindchange="templateInput" /></view><view class="slot-note">模板供诊所重复使用，请填写通用说明。使用时医生可根据患者情况调整；保存或停用模板不会修改已经发送的护理任务。</view><button class="btn primary wide" disabled="{{templateSaving}}" loading="{{templateSaving}}" bindtap="saveCareTemplate">保存模板</button></view>
    </block>
    <block wx:elif="{{page === 'care-edit' && profile && profile.role !== 'frontdesk'}}">
      <view class="back" bindtap="goHome">← 返回工作台</view><text class="eyebrow">CARE TASK</text><view class="title">安排护理任务</view><view class="subtitle">{{careEditor.patient}} · {{careEditor.doctor}}</view>
      <view class="card history-space"><view class="card-title">使用护理模板</view><view wx:if="{{templateLoading}}" class="slot-note">正在加载适用模板…</view><view wx:elif="{{templateError}}" class="slot-note">{{templateError}}<button class="mini-btn ghost-mini" bindtap="reloadCareTemplates">重试</button></view><view wx:elif="{{careTemplateChoices.length === 0}}" class="slot-note">暂无适用于 {{careEditor.service}} 的模板，可手动填写后保存为模板。</view><view wx:else class="choices template-choices"><view wx:for="{{careTemplateChoices}}" wx:key="id" class="choice {{careEditor.templateId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="applyCareTemplate">{{item.name}}<text class="choice-sub">{{item.feedbackDays}} 天后反馈</text></view></view><view wx:if="{{careEditor.templateId}}" class="slot-note">已带入“{{careEditor.templateName}}”，可在下方调整内容与日期。<button class="mini-btn ghost-mini" disabled="{{careBusy}}" bindtap="clearCareTemplate">保留内容，改为手动填写</button></view></view>
      <view class="card admin-panel"><view class="field-label">任务标题</view><input disabled="{{careBusy}}" class="input" maxlength="80" value="{{careEditor.title}}" data-field="title" bindinput="careEditorInput" /><view class="field-label">患者可见的护理说明</view><textarea disabled="{{careBusy}}" class="input textarea care-textarea" maxlength="3000" value="{{careEditor.instructions}}" data-field="instructions" bindinput="careEditorInput" placeholder="填写适用于本次就诊的护理说明及注意事项" /><view class="field-label">希望患者反馈的日期</view><picker disabled="{{careBusy}}" mode="date" start="{{careToday}}" value="{{careEditor.dueDate}}" data-field="dueDate" bindchange="careEditorInput"><view class="picker-value">{{careEditor.dueDate}} ⌄</view></picker><view class="slot-note">发送后患者可以查看说明并反馈；请确认内容适用于该患者。</view><button class="btn primary wide" loading="{{careBusy}}" disabled="{{careBusy}}" bindtap="publishCare">发送给患者</button><button class="btn ghost wide" disabled="{{careBusy || templateSaving}}" bindtap="saveCareAsTemplate">将当前内容另存为模板</button></view>
    </block>
    <block wx:elif="{{page === 'care-review' && selectedCare && profile && profile.role !== 'frontdesk'}}">
      <view class="back" bindtap="goHome">← 返回工作台</view><text class="eyebrow">FOLLOW-UP REVIEW</text><view class="title">护理反馈处理</view><view class="subtitle">{{selectedCare.patient}} · {{selectedCare.title}} · {{selectedCare.statusLabel}}</view>
      <template wx:if="{{selectedCare.feedback}}" is="carePhotoPanel" data="{{carePhotos, photosLoading, photosError, photoBusy, careBusy, editable: false}}" />
      <view class="card admin-panel"><view class="card-title">护理说明</view><text class="care-instructions">{{selectedCare.instructions}}</text></view>
      <view wx:if="{{selectedCare.feedback}}" class="card"><view class="appointment-top"><text class="card-title">患者反馈</text><text wx:if="{{selectedCare.feedback.attention}}" class="badge care-attention">需关注</text></view><view class="appointment-meta">不适情况：{{selectedCare.feedback.pain}}</view><view class="appointment-meta">出血：{{selectedCare.feedback.bleeding ? '有' : '无'}} · 肿胀：{{selectedCare.feedback.swelling ? '有' : '无'}}</view><text class="care-instructions">{{selectedCare.feedback.note || '未填写补充说明'}}</text></view><view wx:else class="card empty">患者尚未提交反馈</view>
      <view wx:if="{{selectedCare.status === 'published' && selectedCare.dueDate < careToday}}" class="card"><view class="card-title">{{selectedCare.followupState === 'lost' ? '失访跟进' : '逾期跟进'}}</view><view class="slot-note">逾期 {{selectedCare.lossAfterDays}} 天或连续 3 次无法联系标记失访；每次联系后 {{selectedCare.followupIntervalDays}} 天再次跟进。补交反馈自动恢复，无需关闭护理任务。</view><view wx:for="{{selectedCare.followups}}" wx:key="requestKey" class="appointment-meta">{{item.outcome === 'reached' ? '已联系' : item.outcome === 'declined' ? '暂不反馈' : '无法联系'}} · {{item.note}} · 再次联系 {{item.nextContactDate}}</view><textarea class="input textarea care-textarea" disabled="{{careBusy}}" maxlength="1000" value="{{careContactNote}}" bindinput="careContactInput" placeholder="填写实际联系结果与下一步（仅诊所可见）" /><view class="work-actions"><button class="mini-btn" disabled="{{careBusy || selectedCare.nextContactDate > careToday}}" data-outcome="reached" bindtap="recordCareContact">已联系</button><button class="mini-btn" disabled="{{careBusy || selectedCare.nextContactDate > careToday}}" data-outcome="unreachable" bindtap="recordCareContact">无法联系</button><button class="mini-btn" disabled="{{careBusy || selectedCare.nextContactDate > careToday}}" data-outcome="declined" bindtap="recordCareContact">暂不反馈</button></view><view wx:if="{{selectedCare.nextContactDate}}" class="slot-note">再次联系日期 {{selectedCare.nextContactDate}}</view></view>
      <view wx:if="{{selectedCare.status === 'waiting_review'}}" class="card"><button class="mini-btn" disabled="{{careBusy}}" bindtap="openCareTriage">人工分级与处理时限</button><view wx:if="{{selectedCare.triage}}" class="slot-note">{{selectedCare.triage.priority === 'urgent' ? '紧急' : selectedCare.triage.priority === 'priority' ? '优先' : '常规'}} · {{selectedCare.triage.destination === 'admin' ? '诊所管理员' : '接诊医生'}} · 截止 {{selectedCare.triage.deadline}}</view><view wx:if="{{careTriageEditor}}"><view class="choices"><button class="mini-btn ghost-mini" data-field="priority" data-value="routine" bindtap="careTriageChoice">常规</button><button class="mini-btn" data-field="priority" data-value="priority" bindtap="careTriageChoice">优先</button><button class="mini-btn" data-field="priority" data-value="urgent" bindtap="careTriageChoice">紧急</button></view><view class="choices"><button class="mini-btn ghost-mini" data-field="destination" data-value="doctor" bindtap="careTriageChoice">接诊医生</button><button class="mini-btn ghost-mini" data-field="destination" data-value="admin" bindtap="careTriageChoice">诊所管理员</button></view><view class="slot-note">当前分级：{{careTriageEditor.priority === 'urgent' ? '紧急' : careTriageEditor.priority === 'priority' ? '优先' : '常规'}} · {{careTriageEditor.destination === 'admin' ? '诊所管理员' : '接诊医生'}}。人工选择，不由症状自动推断。</view><input class="input" type="number" data-field="hours" value="{{careTriageEditor.hours}}" bindinput="careTriageInput" placeholder="处理时限（小时）" /><textarea class="textarea" maxlength="1000" data-field="note" value="{{careTriageEditor.note}}" bindinput="careTriageInput" placeholder="诊所内部处理说明，患者端不展示" /><button class="mini-btn" disabled="{{careBusy}}" bindtap="saveCareTriage">保存处理安排</button></view></view><view wx:if="{{selectedCare.status === 'waiting_review'}}" class="card"><view class="card-title">填写处理意见</view><view class="slot-note">以下意见将展示给患者，请记录已采取的沟通或后续安排。</view><textarea class="input textarea care-textarea" maxlength="1000" value="{{careResolutionNote}}" bindinput="careResolutionInput" placeholder="例如：已电话联系，并确认后续安排" /><button class="btn primary wide" loading="{{careBusy}}" disabled="{{careBusy}}" bindtap="resolveCare">保存意见并完成跟进</button></view>
      <view wx:if="{{selectedCare.resolution}}" class="card"><view class="card-title">已记录的处理意见</view><text class="care-instructions">{{selectedCare.resolution.note}}</text></view>
    </block>
    <block wx:elif="{{page === 'schedule-batch' && batchSource && profile && profile.role === 'admin'}}">
      <view class="back" bindtap="returnToSchedules">← 返回排班配置</view><text class="eyebrow">BATCH SCHEDULE</text><view class="title">批量复制排班</view><view class="subtitle">来源：{{batchSource.doctor}} · {{batchSource.date}}。仅复制已保存的时段与容量。</view>
      <view class="card history-space"><view class="card-title">来源时段</view><view wx:for="{{batchSource.slots}}" wx:key="slot" class="schedule-row"><text>{{item.slot}}</text><text>容量 {{item.capacity}}</text><text class="badge">{{item.enabled ? '开放' : '已关闭'}}</text></view></view>
      <view class="card"><view class="field-label">目标医生</view><view class="choices"><view wx:for="{{scheduleDoctors}}" wx:key="*this" class="choice {{batchDoctor === item ? 'selected' : ''}}" data-doctor="{{item}}" bindtap="batchDoctorChange">{{item}}</view></view><view class="field-label">复制方式</view><view class="choices"><view class="choice {{batchMode === 'open' ? 'selected' : ''}}" data-mode="open" bindtap="batchModeChange">复制并开放</view><view class="choice {{batchMode === 'copy' ? 'selected' : ''}}" data-mode="copy" bindtap="batchModeChange">保留来源开放状态</view></view>
        <view class="field-label">目标日期 · 已选 {{batchSelectedCount}} 天</view><view class="batch-shortcuts"><button class="mini-btn ghost-mini" data-mode="week" bindtap="batchQuickSelect">未来 7 天</button><button class="mini-btn ghost-mini" data-mode="weekday" bindtap="batchQuickSelect">与来源同星期</button><button class="mini-btn ghost-mini" data-mode="all" bindtap="batchQuickSelect">全部日期</button><button class="mini-btn ghost-mini" data-mode="clear" bindtap="batchQuickSelect">清空</button></view><view class="choices batch-date-grid"><view wx:for="{{batchDates}}" wx:key="key" class="choice {{item.selected ? 'selected' : ''}} {{item.disabled ? 'disabled' : ''}}" data-date="{{item.key}}" bindtap="batchDateToggle">{{item.label}}<text wx:if="{{item.disabled}}" class="choice-sub">来源日期</text></view></view><view class="slot-note">复制将替换目标日期已有排班；原有预约保留。请选择日期后预览，确认冲突和覆盖情况。</view><button class="btn ghost wide" disabled="{{batchPreviewing || batchSaving || batchSelectedCount === 0}}" loading="{{batchPreviewing}}" bindtap="previewScheduleBatch">预览复制结果</button>
      </view>
      <view wx:if="{{batchError}}" class="card"><text class="care-instructions">{{batchError}}</text><view class="slot-note">来源变更时返回重新加载；目标变更或占用冲突时调整选择并重新预览。</view></view>
      <view wx:if="{{batchResult}}" class="card success"><view class="check">✓</view><view class="success-title">已配置 {{batchResult.count}} 个日期</view><view class="subtitle">{{batchResult.mode === 'open' ? '复制的时段已开放，患者可按剩余号源预约。' : '时段已复制，开放状态与来源一致。'}}</view></view>
      <view wx:if="{{batchPreview}}" class="card"><view class="card-title">复制预览 · {{batchPreview.targets.length}} 天</view><view class="slot-note">{{batchPreview.mode === 'open' ? '全部来源时段将开放' : '开放状态与来源一致'}} · 预览有效至 {{batchPreview.expiresLabel}}</view><view wx:for="{{batchPreview.targets}}" wx:key="date" class="batch-preview-row"><view class="appointment-top"><text class="patient-name">{{item.date}} · {{item.doctor}}</text><text class="badge {{item.problem ? 'care-attention' : ''}}">{{item.problem ? '有冲突' : item.existing ? '覆盖已有排班' : '新增排班'}}</text></view><view class="appointment-meta">已占用 {{item.used}} 个号源 · {{item.problem ? '无法复制' : '复制后剩余 ' + item.remaining + ' 个号源'}}</view><text wx:if="{{item.problem}}" class="care-instructions">{{item.problem}}</text></view><view class="slot-note">{{batchPreview.canCommit ? '全部目标可复制；提交时会再次核对版本和预约占用。' : '存在冲突，整批尚未写入。请调整来源或目标后重新预览。'}}</view><button class="btn primary wide" disabled="{{batchSaving || batchPreviewing || !batchPreview.canCommit}}" loading="{{batchSaving}}" bindtap="commitScheduleBatch">{{batchPreview.mode === 'open' ? '确认复制并开放号源' : '确认复制排班'}}</button></view>
    </block>
    <block wx:elif="{{page === 'schedules' && profile && profile.role === 'admin'}}">
      <view class="back" bindtap="goHome">← 返回工作台</view><text class="eyebrow">DOCTOR SCHEDULE</text><view class="title">排班与号源</view><view class="subtitle">设置未来 30 天的医生出诊时段与接待容量。</view>
      <view class="card admin-panel">
        <view class="field-label">出诊医生</view><view class="choices"><view wx:for="{{scheduleDoctors}}" wx:key="*this" class="choice {{scheduleDoctor === item ? 'selected' : ''}}" data-doctor="{{item}}" bindtap="scheduleDoctorChange">{{item}}</view></view>
        <view class="field-label">出诊日期</view><picker disabled="{{scheduleSaving}}" range="{{dates}}" range-key="label" value="{{scheduleDateIndex}}" bindchange="scheduleDateChange"><view class="picker-value">{{dates[scheduleDateIndex].label}} <text>⌄</text></view></picker>
        <view class="time-grid"><view><view class="field-label">开始时间</view><picker disabled="{{scheduleSaving}}" mode="time" value="{{scheduleStart}}" data-field="scheduleStart" bindchange="scheduleTimeChange"><view class="picker-value">{{scheduleStart}} ⌄</view></picker></view><view><view class="field-label">结束时间</view><picker disabled="{{scheduleSaving}}" mode="time" value="{{scheduleEnd}}" data-field="scheduleEnd" bindchange="scheduleTimeChange"><view class="picker-value">{{scheduleEnd}} ⌄</view></picker></view></view>
        <view class="field-label">每半小时接待人数（1–10 人）</view><input disabled="{{scheduleSaving}}" class="input" type="number" maxlength="2" value="{{scheduleCapacity}}" bindinput="scheduleCapacityChange" />
        <view class="schedule-toggle"><view><text>开放预约</text><text class="section-sub">关闭后保留已有预约，停止新增预约</text></view><switch disabled="{{scheduleSaving}}" color="#28745c" checked="{{scheduleEnabled}}" bindchange="scheduleEnabledChange" /></view>
        <view class="slot-note">开始、结束时间请选整点或半点；结束时间不生成号源。保存将替换当天排班，已有预约的时段不能移除。</view>
        <view class="button-row"><button class="btn ghost" disabled="{{scheduleSaving}}" bindtap="loadSchedule">重新加载</button><button class="btn primary" loading="{{scheduleSaving}}" disabled="{{scheduleLoading || scheduleSaving || scheduleVersion === null}}" bindtap="saveSchedule">保存排班</button></view>
      </view>
      <view class="section-title"><text>当前已保存的号源</text><text class="section-sub">{{scheduleDoctor}} · {{dates[scheduleDateIndex].label}}</text></view>
      <view wx:if="{{scheduleLoading}}" class="card empty">正在加载排班…</view><view wx:elif="{{scheduleSlots.length === 0}}" class="card empty">尚未配置出诊时段</view>
      <view wx:else class="card"><view wx:for="{{scheduleSlots}}" wx:key="slot" class="schedule-row"><text>{{item.slot}}</text><text>占用 {{item.used}} / 容量 {{item.capacity}}</text><text class="badge">{{item.enabled ? '开放' : '已关闭'}}</text></view></view>
      <button class="btn primary wide" disabled="{{scheduleLoading || scheduleSaving || scheduleVersion === null || scheduleSlots.length === 0}}" bindtap="openScheduleBatch">将已保存排班复制到多个日期</button><view class="slot-note">复制使用已保存排班，上方尚未保存的修改不会带入。</view>
    </block>
    <block wx:else>
    <text class="eyebrow">CLINIC WORKSPACE</text><view class="title">诊所工作台</view><view class="subtitle">预约申请与诊后任务演示</view>
    <view wx:if="{{profile && profile.role !== 'frontdesk'}}" class="choices work-shortcuts"><view class="choice" data-status="overdue" bindtap="showWorklist">查看逾期事项</view><view class="choice" data-status="waiting_feedback" bindtap="showWorklist">待反馈护理</view><view class="choice" data-status="waiting_review" bindtap="showWorklist">待处理反馈</view></view>
    <view wx:if="{{profile && profile.role !== 'frontdesk'}}" class="my-entry" bindtap="showHistory"><view><text class="my-entry-title">就诊记录检索</text><text class="my-entry-sub">按就诊人、日期、医生查找并进入时间轴</text></view><text class="arrow">›</text></view>
    <view class="my-entry" bindtap="showStatistics"><view><text class="my-entry-title">诊所运营统计</text><text class="my-entry-sub">{{profile.role === 'frontdesk' ? '预约进度、实际到店和每日趋势' : '预约、接诊、护理反馈和复查进度'}}</text></view><text class="arrow">›</text></view>
    <view class="my-entry" bindtap="showWorklist"><view><text class="my-entry-title">诊所待办 · {{workError ? '加载失败' : workCounts.all + ' 项'}}</text><text class="my-entry-sub">{{workLoading ? '正在更新…' : (profile.role === 'frontdesk' ? '集中处理预约确认、取消申请与到店' : '护理反馈、预约处理和逾期复查')}}{{workCounts.attention ? ' · ' + workCounts.attention + ' 项需关注' : ''}}</text></view><text class="arrow">›</text></view>
    <view wx:if="{{profile && profile.role !== 'frontdesk'}}" class="my-entry" bindtap="showCareTemplates"><view><text class="my-entry-title">护理模板</text><text class="my-entry-sub">维护常用说明，发送护理任务时直接选用</text></view><text class="arrow">›</text></view>
    <view wx:if="{{profile && profile.role !== 'frontdesk'}}" class="my-entry" bindtap="showRecalls"><view><text class="my-entry-title">患者复查安排</text><text class="my-entry-sub">{{recallPendingCount}} 项待预约，查看预约与复查进度</text></view><text class="arrow">›</text></view>
    <view class="card history-space"><view class="card-title">业务与运行管理</view><button class="mini-btn" data-section="queue" bindtap="showExtension">候诊队列</button><button wx:if="{{profile.role === 'admin' || profile.role === 'frontdesk'}}" class="mini-btn" data-section="requests" bindtap="showExtension">改期申请审核</button><button wx:if="{{profile.role === 'admin' || profile.role === 'doctor'}}" class="mini-btn" data-section="recipes" bindtap="showExtension">护理流程模板</button><button wx:if="{{profile.role === 'admin' || profile.role === 'doctor'}}" class="mini-btn" data-section="screening" bindtap="showExtension">初筛人工复核</button><block wx:if="{{profile.role === 'admin'}}"><button class="mini-btn" data-section="resources" bindtap="showExtension">资源与停诊</button><button class="mini-btn" data-section="rules" bindtap="showExtension">预约规则</button><button class="mini-btn" data-section="billingStats" bindtap="showExtension">收款统计</button><button class="mini-btn" data-section="screeningStats" bindtap="showExtension">初筛统计</button><button class="mini-btn" data-section="contentStats" bindtap="showExtension">内容运营</button><button class="mini-btn" data-section="system" bindtap="showExtension">备份与运行状态</button><button class="mini-btn" data-section="audit" bindtap="showExtension">操作审计</button><button class="mini-btn" data-section="privacy" bindtap="showExtension">隐私告知维护</button></block></view>
    <view wx:if="{{profile && (profile.role === 'admin' || profile.role === 'doctor')}}" class="my-entry" bindtap="showContentReviews"><view><text class="my-entry-title">独立内容审核</text><text class="my-entry-sub">查看待审核正文、填写通过或退回意见</text></view><text class="arrow">›</text></view>
    <view wx:if="{{profile && (profile.role === 'admin' || profile.role === 'doctor')}}" class="my-entry" bindtap="showArticleAdmin"><view><text class="my-entry-title">科普分类与文章</text><text class="my-entry-sub">维护分类、编辑正文、发布与下架</text></view><text class="arrow">›</text></view>
    <view wx:if="{{profile && profile.role === 'admin'}}" class="my-entry" bindtap="showCatalogAdmin"><view><text class="my-entry-title">诊所、医生与服务资料</text><text class="my-entry-sub">维护基础信息、新增资料及启停</text></view><text class="arrow">›</text></view><view wx:if="{{profile && profile.role === 'admin'}}" class="my-entry" bindtap="openSchedules"><view><text class="my-entry-title">医生排班与号源</text><text class="my-entry-sub">设置出诊日期、开放时段和容量</text></view><text class="arrow">›</text></view>
    <view wx:if="{{profile && profile.role === 'admin'}}" class="card admin-panel"><view class="card-title">员工授权</view><view class="appointment-meta">生成一次性授权码，交给需要进入工作台的员工；授权码 24 小时内有效。</view><view class="choices"><view class="choice {{inviteRole === 'frontdesk' ? 'selected' : ''}}" data-role="frontdesk" bindtap="selectInviteRole">前台</view><view class="choice {{inviteRole === 'doctor' ? 'selected' : ''}}" data-role="doctor" bindtap="selectInviteRole">医生</view><view class="choice {{inviteRole === 'admin' ? 'selected' : ''}}" data-role="admin" bindtap="selectInviteRole">管理员</view></view><view wx:if="{{inviteRole === 'doctor'}}" class="choices doctor-invite"><view wx:for="{{scheduleDoctors}}" wx:key="*this" class="choice {{inviteDoctor === item ? 'selected' : ''}}" data-doctor="{{item}}" bindtap="selectInviteDoctor">{{item}}</view></view><button class="btn primary wide" bindtap="createInvite">生成授权码</button><view wx:if="{{issuedInvite}}" class="invite-code">{{issuedInvite.code}}<text>请保存并安全交给员工；离开工作台后不再显示。</text></view></view>
    <view wx:if="{{profile && profile.role === 'admin'}}" class="card admin-panel"><view class="card-title">员工名单</view><view wx:for="{{staffMembers}}" wx:key="id" class="staff-row"><view><text class="staff-name">{{item.displayName}}</text><text class="staff-detail">{{item.role}} {{item.doctorName || ''}} · {{item.enabled ? '在职' : '已停用'}}</text></view><button wx:if="{{item.enabled && item.id !== profile.id}}" class="mini-btn ghost-mini" data-id="{{item.id}}" bindtap="disableStaff">停用</button></view></view>
    <view wx:if="{{profile.role === 'admin' || profile.role === 'doctor'}}" class="my-entry" bindtap="showCarePlans"><view><text class="my-entry-title">诊后多节点计划</text><text class="my-entry-sub">管理计划草稿、节点进度和待处理反馈</text></view><text class="arrow">›</text></view>
    <view class="stats"><view class="stat"><text>预约总数</text><text class="stat-value">{{appointments.length}}</text></view><view class="stat"><text>待确认</text><text class="stat-value">{{pendingCount}}</text></view><view class="stat"><text>护理进行中</text><text class="stat-value">{{carePendingCount}}</text></view></view>
    <view class="section-title"><text>预约管理</text><text class="section-sub">按预约状态逐步处理</text></view>
    <view wx:if="{{appointments.length === 0}}" class="card empty">暂无预约。患者提交后会显示在这里。</view>
    <view wx:for="{{appointments}}" wx:key="id" class="card appointment"><view class="appointment-top"><text class="patient-name">{{item.patient}}</text><text class="badge">{{item.status}}</text></view><view class="appointment-meta">{{item.service}} · {{item.doctor}}</view><view wx:if="{{item.closureNotice}}" class="slot-note">停诊安排：{{item.closureNotice}}，请联系诊所核实预约。</view><view class="appointment-meta">{{item.date}} {{item.slot}} · 来源：{{item.source}}</view><button wx:if="{{profile.role !== 'frontdesk'}}" class="mini-btn ghost-mini" data-id="{{item.id}}" bindtap="openHistory">查看就诊时间轴</button><button wx:if="{{profile.role === 'admin' || profile.role === 'frontdesk'}}" class="mini-btn ghost-mini" data-id="{{item.id}}" bindtap="openReschedule">预约详情与处理记录</button><button wx:if="{{profile.role === 'admin' || profile.role === 'frontdesk'}}" class="mini-btn ghost-mini" data-id="{{item.id}}" bindtap="showBilling">收款与待付账单</button><view class="actions"><button wx:if="{{item.status === '待确认' && profile.role !== 'doctor'}}" class="mini-btn" data-id="{{item.id}}" data-status="已预约" bindtap="updateStatus">确认预约</button><button wx:if="{{item.status === '待确认' && profile.role !== 'doctor'}}" class="mini-btn ghost-mini" data-id="{{item.id}}" data-status="已取消" bindtap="updateStatus">拒绝预约</button><button wx:if="{{item.status === '已预约' && profile.role !== 'doctor'}}" class="mini-btn" data-id="{{item.id}}" data-status="已到店" bindtap="updateStatus">标记到店</button><button wx:if="{{item.status === '取消申请中' && profile.role !== 'doctor'}}" class="mini-btn" data-id="{{item.id}}" data-status="已取消" bindtap="updateStatus">同意取消</button><button wx:if="{{item.status === '取消申请中' && profile.role !== 'doctor'}}" class="mini-btn ghost-mini" data-id="{{item.id}}" data-status="已预约" bindtap="updateStatus">保留预约</button><button wx:if="{{(item.status === '已到店' || item.status === '就诊中') && profile.role !== 'frontdesk'}}" class="mini-btn" data-id="{{item.id}}" data-status="已完成" bindtap="updateStatus">完成接诊</button><button wx:if="{{item.status === '已完成' && profile.role !== 'frontdesk'}}" class="mini-btn" data-appointmentid="{{item.id}}" bindtap="openCareEditor">安排护理</button><button wx:if="{{item.status === '已完成' && profile.role !== 'frontdesk'}}" class="mini-btn ghost-mini" data-appointmentid="{{item.id}}" bindtap="newCarePlan">安排多节点计划</button></view></view>
    <block wx:if="{{profile && profile.role !== 'frontdesk'}}"><view class="section-title"><text>护理与反馈队列</text><text class="section-sub">{{carePendingCount}} 项进行中</text></view><view wx:if="{{tasks.length === 0}}" class="card empty">暂无护理任务</view><view wx:for="{{tasks}}" wx:key="id" class="card task"><view class="appointment-top"><text class="patient-name">{{item.title}}</text><text class="badge {{item.feedback && item.feedback.attention && item.status === 'waiting_review' ? 'care-attention' : ''}}">{{item.feedback && item.feedback.attention && item.status === 'waiting_review' ? '需关注' : item.statusLabel}}</text></view><view class="appointment-meta">{{item.patient}} · {{item.doctor}} · 反馈日期 {{item.dueDate}}</view><text class="care-preview">{{item.instructions || '尚未填写护理说明，患者暂不可见'}}</text><button wx:if="{{item.status === 'draft'}}" class="mini-btn" data-taskid="{{item.id}}" bindtap="openCareEditor">编写并发送</button><button wx:else class="mini-btn" data-id="{{item.id}}" bindtap="openCareReview">{{item.status === 'waiting_review' ? '查看并处理反馈' : '查看任务'}}</button></view></block>
  </block>
  </block>
  <view class="footer">APEXDENTAL · {{isDemo ? '演示数据仅供流程体验' : '口腔健康服务'}}</view>
</view>
