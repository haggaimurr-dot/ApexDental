      <block wx:if="{{step === 1}}"><view class="card"><view class="card-title">选择服务与时间</view><view class="field-label">服务项目</view><view class="choices"><view wx:for="{{services}}" wx:key="*this" wx:if="{{!bookingRecall || item === bookingRecall.service}}" class="choice {{booking.service === item ? 'selected' : ''}}" data-field="service" data-value="{{item}}" bindtap="pick">{{item}}</view></view><view class="field-label">接诊医生</view><view class="choices"><view wx:for="{{doctors}}" wx:key="*this" wx:if="{{!bookingRecall || item === bookingRecall.doctor}}" class="choice {{booking.doctor === item ? 'selected' : ''}}" data-field="doctor" data-value="{{item}}" bindtap="pick">{{item}}</view></view><view class="field-label">预约日期</view><picker range="{{dates}}" range-key="label" value="{{bookingDateIndex}}" bindchange="bookingDateChange"><view class="picker-value">{{dates[bookingDateIndex].label}} <text>⌄</text></view></picker><view class="field-label">可预约时段</view><view wx:if="{{availabilityLoading}}" class="slot-note">正在查询号源…</view><view wx:elif="{{slots.length === 0}}" class="slot-note">该日期暂无开放时段，请选择其他日期或联系诊所。</view><view class="choices"><view wx:for="{{slots}}" wx:key="time" class="choice slot {{booking.slot === item.time ? 'selected' : ''}} {{item.disabled ? 'disabled' : ''}}" data-value="{{item.time}}" data-disabled="{{item.disabled}}" bindtap="pickSlot">{{item.time}}<text class="choice-sub">{{item.disabled ? '不可约' : '余 ' + item.remaining}}</text></view></view><view class="slot-note">提交后保留号源，待诊所确认；取消后释放号源。</view><button class="btn primary wide" disabled="{{availabilityLoading || !booking.slot}}" bindtap="next">填写就诊信息 →</button></view></block>
      <block wx:elif="{{step === 2}}"><view class="card"><view class="card-title">填写就诊信息</view><view class="field-label">就诊成员</view><picker disabled="{{busy || !!bookingRecall}}" range="{{memberChoices}}" range-key="label" value="{{bookingMemberIndex}}" bindchange="bookingMemberChange"><view class="picker-value">{{memberChoices[bookingMemberIndex].label}} ⌄</view></picker><button wx:if="{{!bookingRecall}}" class="mini-btn ghost-mini" bindtap="showMembers">添加或管理家庭成员</button><view class="field-label">就诊人姓名</view><input disabled="{{true}}" class="input" placeholder="请选择就诊成员" value="{{booking.name}}" data-field="name" bindinput="input" /><view class="field-label">联系电话</view><input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{booking.phone}}" data-field="phone" bindinput="input" /><view class="field-label">备注（选填）</view><textarea class="input textarea" placeholder="需要提前告知诊所的内容" value="{{booking.note}}" data-field="note" bindinput="input" /><checkbox-group bindchange="consentChange"><label class="consent"><checkbox value="yes" color="#28745c" />我已阅读预约说明与隐私告知，并同意诊所为安排本次服务处理以上信息。</label></checkbox-group><view class="button-row"><button class="btn ghost" bindtap="previous">返回</button><button class="btn primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">提交预约 →</button></view></view></block>
      <block wx:else><view class="card success"><view class="check">✓</view><view class="success-title">预约申请已提交</view><view class="subtitle">诊所将在营业时间内与您联系确认。</view><view class="summary"><view>服务项目 <text>{{booking.service}}</text></view><view>预约时间 <text>{{booking.date}} {{booking.slot}}</text></view><view>就诊人 <text>{{booking.name}}</text></view><view>状态 <text>待诊所确认</text></view></view><button class="btn primary wide" bindtap="showAppointments">查看我的预约</button></view></block>
    </block>
    <block wx:elif="{{page === 'appointments'}}">
      <view class="back" bindtap="goHome">← 返回首页</view><text class="eyebrow">MY APPOINTMENTS</text><view class="title">我的预约</view><view class="subtitle">当前账号提交的预约记录</view>
      <view wx:if="{{patientAppointments.length === 0}}" class="card empty">暂无预约记录。<button class="btn primary wide" bindtap="startBooking">去预约</button></view>
